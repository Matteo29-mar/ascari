generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CarMarketStatus {
  AVAILABLE
  SOLD_PENDING_REMOVAL
  REMOVED_AFTER_SALE
}

enum CashoutStatus {
  REQUESTED
  PAID
  FAILED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stripeAccountId             String?   @unique
  stripeAccountStatus         String    @default("NOT_STARTED")
  stripeChargesEnabled        Boolean   @default(false)
  stripePayoutsEnabled        Boolean   @default(false)
  stripeDetailsSubmitted      Boolean   @default(false)
  stripeOnboardingCompletedAt DateTime?
  paymentsEnabledAt           DateTime?

  cars  Car[]
  likes Like[]

  buyerOffers  Offer[]   @relation("BuyerOffers")
  sellerOffers Offer[]   @relation("SellerOffers")
  messages     Message[]

  buyerChats  Chat[] @relation("BuyerChats")
  sellerChats Chat[] @relation("SellerChats")

  inspectorProfile InspectorProfile?

  sellerInspectionRequests InspectionRequest[] @relation("SellerInspectionRequests")
  inspectionReports        InspectionReport[]
  inspectorCashouts        InspectorCashout[]

  buyerPayments  Payment[] @relation("BuyerPayments")
  sellerPayments Payment[] @relation("SellerPayments")

  buyerSaleHistories  SaleHistory[] @relation("BuyerSaleHistories")
  sellerSaleHistories SaleHistory[] @relation("SellerSaleHistories")
}

model InspectorProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workshopName    String
  workshopAddress String?
  email           String
  phone           String

  city      String?
  latitude  Float?
  longitude Float?

  radiusKm Int @default(70)

  workStartMin Int @default(540)
  workEndMin   Int @default(1080)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots InspectorSlot[]

  requests               InspectionRequest[]
  calendarConfirmedColor String              @default("#22c55e")

  @@index([latitude, longitude])
  @@index([radiusKm])
}

model InspectorSlot {
  id          Int              @id @default(autoincrement())
  inspectorId String
  inspector   InspectorProfile @relation(fields: [inspectorId], references: [id], onDelete: Cascade)

  startAt     DateTime
  endAt       DateTime
  isAvailable Boolean  @default(true)

  createdAt DateTime @default(now())

  requests InspectionRequest[]

  @@index([inspectorId, startAt])
  @@index([inspectorId, endAt])
}

model InspectionRequest {
  id Int @id @default(autoincrement())

  carId Int
  car   Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  sellerId String
  seller   User   @relation("SellerInspectionRequests", fields: [sellerId], references: [id])

  inspectorId String
  inspector   InspectorProfile @relation(fields: [inspectorId], references: [id], onDelete: Cascade)

  startAt DateTime
  endAt   DateTime

  inspectorSlotId Int
  inspectorSlot   InspectorSlot @relation(fields: [inspectorSlotId], references: [id], onDelete: Cascade)

  status    InspectionStatus @default(PENDING)
  matchType MatchType        @default(PERFECT)

  notes String?

  chat Chat? @relation("InspectionChat")

  report InspectionReport?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inspectorId, startAt])
  @@index([sellerId, createdAt])
  @@index([carId])
  @@index([inspectorSlotId])
}

model Car {
  id    Int    @id @default(autoincrement())
  make  String
  model String
  title String
  year  Int

  offerPrice1 Int
  offerPrice2 Int
  offerPrice3 Int

  trimLevel    String?
  priceEur     Int?
  color        String?
  transmission String
  fuelType     String
  engine       String?
  horsepower   Int?
  torqueNm     Int?
  drivetrain   String?
  seats        Int?
  doors        Int?
  description  String?
  mileageKm    Int?
  photos       String[]
  coverUrl     String?

  isPeriziata       Boolean   @default(false)
  periziaDocUrl     String?
  periziaUploadedAt DateTime?

  paymentEnabled      Boolean   @default(false)
  salePriceEur        Int?
  ascariFeeEur        Int?
  inspectionFeeEur    Int?
  sellerNetEur        Int?
  paymentStatus       String    @default("NOT_CONFIGURED")
  paymentConfiguredAt DateTime?

  marketStatus            CarMarketStatus @default(AVAILABLE)
  soldAt                  DateTime?
  removalScheduledAt      DateTime?
  visuallyRemovedAt       DateTime?
  soldByPaymentId         Int?
  soldBySaleHistoryId     Int?

  payments Payment[]

  saleHistories SaleHistory[]

  offers Offer[] @relation("CarOffers")

  locationText String
  city         String
  country      String?

  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id])

  likes Like[]

  inspectionRequests InspectionRequest[]

  inspectionReports InspectionReport[]

  qrToken         String?   @unique
  qrCodeCreatedAt DateTime?
  qrScans         QrScan[]

  arvePricingAnalysis ArvePricingAnalysis?

  @@index([make, model])
  @@index([latitude, longitude])
  @@index([ownerId])
  @@index([paymentEnabled])
  @@index([marketStatus])
  @@index([removalScheduledAt])
  @@index([visuallyRemovedAt])
}

model ArvePricingAnalysis {
  id    Int @id @default(autoincrement())
  carId Int @unique
  car   Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  originalOfferPrice1 Int
  originalOfferPrice2 Int
  originalOfferPrice3 Int

  quickSalePrice  Int
  reservePrice    Int
  democraticPrice Int

  marketMin    Int
  marketMax    Int
  marketMedian Int

  recommendation String
  message        String
  confidence     Float
  evidenceLevel  Int

  comparableItems     Json?
  privateMatchesCount Int @default(0)

  sourceType    String
  modelUsed     String?
  promptVersion String?
  inputTokens   Int?
  outputTokens  Int?
  totalTokens   Int?
  rawResponseJson Json?
  analysisError   String?

  userDecision      String @default("PENDING")
  appliedOfferPrice1 Int?
  appliedOfferPrice2 Int?
  appliedOfferPrice3 Int?
  decidedAt          DateTime?

  actualSoldPriceEur Int?
  actualSoldAt       DateTime?
  daysToSell         Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceType])
  @@index([userDecision])
  @@index([actualSoldAt])
  @@index([createdAt])
}

model QrScan {
  id Int @id @default(autoincrement())

  carId Int
  car   Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  visitorHash String
  userAgent   String?
  scannedAt   DateTime @default(now())

  @@index([carId, scannedAt])
  @@index([carId, visitorHash])
}

model InspectionReport {
  id Int @id @default(autoincrement())

  inspectionRequestId Int               @unique
  inspectionRequest   InspectionRequest @relation(fields: [inspectionRequestId], references: [id], onDelete: Cascade)

  inspectorUserId String
  inspectorUser   User   @relation(fields: [inspectorUserId], references: [id], onDelete: Cascade)

  carId Int
  car   Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  cashout InspectorCashout?

  title          String?
  overallStatus  String?
  plate          String?
  vin            String?
  km             Int?
  inspectionDate DateTime?
  location       String?

  bodyworkNotes    String?
  interiorNotes    String?
  engineNotes      String?
  mechanicsNotes   String?
  tiresNotes       String?
  electronicsNotes String?
  testDriveNotes   String?
  defectsFound     String?
  finalOpinion     String?
  estimatedValue   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inspectorUserId, createdAt])
  @@index([carId])
}

model InspectorCashout {
  id Int @id @default(autoincrement())

  reportId Int              @unique
  report   InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  inspectorUserId String
  inspectorUser   User   @relation(fields: [inspectorUserId], references: [id], onDelete: Cascade)

  amountEur Int    @default(120)
  currency  String @default("eur")

  status CashoutStatus @default(REQUESTED)

  stripeTransferId String? @unique
  stripeAccountId  String?

  failureReason String?

  requestedAt DateTime @default(now())
  paidAt      DateTime?
  failedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inspectorUserId, createdAt])
  @@index([status])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  carId     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  car  Car  @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([userId, carId])
}

model Offer {
  id        Int      @id @default(autoincrement())
  carId     Int
  buyerId   String
  sellerId  String
  amount    Int
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  buyer  User @relation("BuyerOffers", fields: [buyerId], references: [id])
  seller User @relation("SellerOffers", fields: [sellerId], references: [id])
  car    Car  @relation("CarOffers", fields: [carId], references: [id])

  chat Chat? @relation("OfferChat")
}

model Chat {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  buyerId  String
  sellerId String
  buyer    User   @relation("BuyerChats", fields: [buyerId], references: [id])
  seller   User   @relation("SellerChats", fields: [sellerId], references: [id])

  offerId Int?
  offer   Offer? @relation("OfferChat", fields: [offerId], references: [id])

  inspectionRequestId Int?
  inspectionRequest   InspectionRequest? @relation("InspectionChat", fields: [inspectionRequestId], references: [id], onDelete: Cascade)

  messages Message[]

  @@unique([offerId])
  @@unique([inspectionRequestId])
  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
}

model Message {
  id        Int       @id @default(autoincrement())
  content   String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  chatId Int
  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id])
}

model Payment {
  id Int @id @default(autoincrement())

  carId Int
  car   Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  buyerId String
  buyer   User   @relation("BuyerPayments", fields: [buyerId], references: [id])

  sellerId String
  seller   User   @relation("SellerPayments", fields: [sellerId], references: [id])

  stripePaymentIntentId  String  @unique
  stripeClientSecret     String?
  stripeChargeId         String?
  stripeTransferId       String?
  stripeApplicationFeeId String?

  amountEur    Int
  ascariFeeEur Int
  inspectionFeeEur Int?
  sellerNetEur Int
  currency     String @default("eur")

  status     String    @default("CREATED")
  paidAt     DateTime?
  refundedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([carId, createdAt])
  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status])
}

model SaleHistory {
  id Int @id @default(autoincrement())

  carId Int?
  car   Car? @relation(fields: [carId], references: [id], onDelete: SetNull)

  buyerId String
  buyer   User   @relation("BuyerSaleHistories", fields: [buyerId], references: [id])

  sellerId String
  seller   User   @relation("SellerSaleHistories", fields: [sellerId], references: [id])

  paymentId Int? @unique

  amountEur    Int
  ascariFeeEur Int?
  inspectionFeeEur Int?
  sellerNetEur Int?

  currency String @default("eur")

  carSnapshot        Json
  inspectionSnapshot Json?

  stripePaymentIntentId String?
  stripeChargeId        String?

  soldAt    DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId, soldAt])
  @@index([sellerId, soldAt])
  @@index([carId])
}

enum InspectionStatus {
  PENDING
  ASSIGNED
  SEEN
  CONFIRMED
  DONE
  CANCELLED
}

enum MatchType {
  PERFECT
  FLEXIBLE_TIME
  RADIUS
}
